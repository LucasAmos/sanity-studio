{
  "version": "1.26.32",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasamos/sanity-studio.git"
  },
  "name": "@lucasamos/sanity-studio",
  "files": [
    "./schema.json"
  ],
  "exports": {
    ".": "./schema.json"
  },
  "main": "./schema.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "build:dev": "SANITY_ACTIVE_ENV=development sanity build",
    "deploy": "sanity deploy",
    "deploy:dev": "SANITY_ACTIVE_ENV=development sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "schema:extract": "sanity schema extract --enforce-required-fields",
    "undeploy": "sanity undeploy --yes",
    "undeploy:dev": "SANITY_ACTIVE_ENV=development sanity undeploy --yes",
    "undeploy:local": "SANITY_ACTIVE_ENV=development sanity undeploy --yes",
    "validate:schema": "sanity schema validate",
    "validate:documents": "sanity documents validate --yes --level info",
    "release": "sanity schema extract --enforce-required-fields && release-it --ci",
    "release:dry-run": "release-it --ci --dry-run",
    "test:watch": "vitest",
    "test": "vitest run",
    "studio:sanity": "sanity"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@sanity/vision": "6.20.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "release-it": "^21.1.1",
    "sanity": "6.20.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.2",
    "@sanity/eslint-config-studio": "^7.0.0",
    "@sanity/vision": "6.20.0",
    "@types/react": "^19.3.0",
    "eslint": "^10.13.0",
    "prettier": "3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "release-it": "^19",
    "sanity": "6.20.0",
    "styled-components": "^6.6.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@types/react": "^19.3.0"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  },
  "hooks": {
    "after:bump": "yarn --mode update-lockfile"
  }
}
